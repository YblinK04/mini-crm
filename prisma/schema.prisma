generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}



model Organization {
  id        String   @id @default(cuid())
  name      String   // Название компании-клиента (например, "Барбершоп ТопГан" или "СТО АвтоЭксперт")
  isActive  Boolean  @default(true) @map("is_active") // Возвращено для контроля лицензии/блокировки филиала
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tasks     Task[]
  users     User[]
  pipelines Pipeline[]
  deals     Deal[]       // Добавлено для сквозной изоляции сделок по филиалам
  companies Company[]
  settings Settings? 
   messages Message[]
  contacts  Contact[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  password       String    
  name           String?
  role           Role           @default(MANAGER) // По умолчанию все сотрудники — менеджеры
  image          String?
  emailVerified  DateTime?
  isActive       Boolean        @default(true) @map("is_active") // Возвращено для безопасного увольнения без удаления истории
  
  // Привязка к компании
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  tasksCreated    Task[] @relation("TaskCreatedBy")
  tasksAssigned   Task[] @relation("TaskAssignedTo")
  // Отношения
  notifications  Notification[]
  assignedDeals  Deal[]         @relation("DealAssignee") // Ответственный за сделки
  activities     ActivityLog[]  // Записи менеджера в ленте активности
  auditLogs      AuditLog[]     // Логи действий для безопасности
  
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  
  @@map("users")
  @@index([organizationId, createdAt]) // Оптимизация вывода списка сотрудников
}

enum Role {
  OWNER   // Владелец бизнеса (может всё, включая экспорт базы клиентов)
  ADMIN   // Администратор системы
  MANAGER // Менеджер по продажам (запрещен экспорт базы)
}



model Pipeline {
  id             String       @id @default(cuid())
  name           String       // Например: "Стрижки", "Продажа косметики", "Ремонт ДВС"
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  stages         Stage[]
  deals          Deal[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  
  @@map("pipelines")
  @@index([organizationId, createdAt]) // Оптимизация вывода воронок филиала
}

model Stage {
  id             String   @id @default(cuid())
  name           String   // Название этапа, например: "Диагностика", "Ожидание запчастей", "Готово"
  color          String   @default("#3b82f6") 
  order          Int      @default(0) // Порядок колонки на доске
  
  pipelineId     String   @map("pipeline_id")
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals          Deal[]

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  @@map("stages")
  @@index([pipelineId, order]) // Идеально для сортировки колонок канбана
}



model Company {
  id             String       @id @default(cuid())
  name           String       // Название компании клиента (для B2B сделок)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  contacts       Contact[]
  deals          Deal[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("companies")
  @@index([organizationId, createdAt])
}

model Message {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")

  contactId      String   @map("contact_id")
  dealId         String?  @map("deal_id")

  channel        String   // 'TELEGRAM' | 'MAX'
  direction      String   // 'IN' | 'OUT'

  externalChatId    String @map("external_chat_id")
  externalMessageId String @map("external_message_id")

  content        String
  attachments    Json?
  rawPayload     Json?    @map("raw_payload")

  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@unique([channel, externalChatId, externalMessageId])
  @@index([organizationId, contactId, createdAt])
  @@index([dealId, createdAt])
  @@map("messages")
}

model Contact {
  id             String       @id @default(cuid())
  firstName      String       @map("first_name")
  lastName       String?      @map("last_name")
  phone          String?      
  email          String?      
  socialLink     String?      @map("social_link")

  // ── Мессенджеры ──
  telegramChatId   String?    @map("telegram_chat_id")
  telegramUsername String?    @map("telegram_username")
  maxUserId        String?    @map("max_user_id")

  customFields   Json?        @map("custom_fields") 

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
   tasks         Task[]
  companyId      String?      @map("company_id")
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  
  deals          Deal[]       @relation("DealContacts")

  messages       Message[]  
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, telegramChatId])
  @@unique([organizationId, maxUserId])
  @@map("contacts")
  @@index([organizationId])
  @@index([phone])
  @@index([companyId])
}



model Deal {
  id             String        @id @default(cuid())
  title          String        // Название сделки (например, "Запись: Иван - Стрижка и борода")
  description    String?       @db.Text
  budget         Int           @default(0) // Храним в копейках (Int). Быстро на слабом железе, совпадает с Zod!
  priority       Priority      @default(MEDIUM)
  order          Int           @default(0) // Порядок карточки внутри колонки
  closeDate      DateTime?     @map("close_date") // Дата закрытия сделки
  
  customFields   Json?         @map("custom_fields")

  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pipelineId     String        @map("pipeline_id")
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId        String        @map("stage_id")
  stage          Stage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tasks          Task[]
  assigneeId     String?       @map("assignee_id")
  assignee       User?         @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  // Привязка к клиентам
  companyId      String?       @map("company_id")
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contacts       Contact[]     @relation("DealContacts")
   messages      Message[]

  documents      Document[]    // Локальные файлы договоров на диске сервера
  activities     ActivityLog[] // Лента активности внутри карточки

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  
  @@map("deals")
  @@index([organizationId, pipelineId, stageId])
  @@index([assigneeId])
  @@index([companyId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Document {
  id         String   @id @default(cuid())
  name       String   
  url        String   
  storageKey String   @map("storage_key") 
  size       Int      
  
  dealId     String   @map("deal_id")
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now()) @map("created_at")
  
  @@map("documents")
  @@index([dealId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  dealId    String   @map("deal_id")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  userId    String   @map("author_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text // Текст заметки менеджера
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("activity_logs")
  @@index([dealId, createdAt]) // Индекс для быстрого вывода и сортировки таймлайна в карточке
}

model Settings {
  id             String   @id @default("singleton")
  organizationId String   @unique @map("organization_id")

  telegramBotToken      String? @map("telegram_bot_token")
  telegramWebhookSecret String? @map("telegram_webhook_secret")
  telegramBotUsername   String? @map("telegram_bot_username")

  maxBotToken      String? @map("max_bot_token")
  maxWebhookSecret String? @map("max_webhook_secret")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  userId         String?      @map("user_id")
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action         String       // Например: "EXPORT_DATABASE_SUCCESS", "UNAUTHORIZED_ATTEMPT_EXPORT"
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  metadata       Json?        // Детали лога безопасности (IP, устройство и т.д.)
  
  createdAt      DateTime     @default(now()) @map("created_at")
  
  @@map("audit_logs")
  @@index([organizationId, createdAt]) // Оптимизация для вывода панели безопасности администратора
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
  @@index([userId, read]) // Индекс для моментального получения счетчика непрочитанных уведомлений
}

model Task {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")

  title          String
  description    String?
  dueAt          DateTime @map("due_at")
  completedAt    DateTime? @map("completed_at")

  createdById    String   @map("created_by_id")
  assignedToId   String?  @map("assigned_to_id")

  dealId         String?  @map("deal_id")
  contactId      String?  @map("contact_id")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedTo   User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, completedAt, dueAt])
  @@index([organizationId, assignedToId, completedAt])
  @@index([organizationId, createdAt])
  @@index([dealId])
  @@index([contactId])
  @@map("tasks")
}